{
  "name": "@bebu/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Shared domain types, enums, validation schemas and pure utilities for the bebu platform",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@bebu/config": "workspace:*",
    "@types/node": "^24.0.0",
    "eslint": "^10.10.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.2"
  }
}
