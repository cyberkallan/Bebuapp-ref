{
  "name": "@bebu/landing",
  "version": "0.1.0",
  "private": true,
  "description": "bebu marketing site and Android download page (static, deployable to any web host)",
  "type": "module",
  "scripts": {
    "dev": "node scripts/sync-downloads.mjs && vite --port 4183 --host 127.0.0.1",
    "build": "node scripts/sync-downloads.mjs && vite build",
    "preview": "vite preview --port 4183 --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "echo 'no tests for static site'",
    "clean": "rm -rf dist public/downloads"
  },
  "devDependencies": {
    "@bebu/config": "workspace:*",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.2"
  },
  "dependencies": {
    "qrcode-generator": "^2.0.4"
  }
}
