# Internal edge for the Talkin stack: plain HTTP on :80, reachable only from
# the host's shared reverse proxy (which terminates TLS for DOMAIN).
{
	auto_https off
	servers {
		trusted_proxies static private_ranges
	}
}

:80 {
	encode zstd gzip

	# Some admin code joins URLs with a double slash; collapse before routing.
	uri path_regexp /{2,} /

	@backend path /api/* /storage/* /socket.io/*
	handle @backend {
		reverse_proxy talkin-backend:5000
	}

	handle {
		reverse_proxy talkin-admin:5001
	}

	log {
		output stdout
		format json
	}
}
