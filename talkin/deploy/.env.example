# Copy to .env and fill in. Never commit .env.

# Public origin the app and admin use (no trailing slash).
DOMAIN=bebu.145.223.79.74.sslip.io
PUBLIC_URL=https://bebu.145.223.79.74.sslip.io

# Shared secret between app/admin and backend (Api.secretKey in the app).
SECRET_KEY=

# Admin panel session signing.
NEXTAUTH_SECRET=

# Firebase web app config (Firebase console > Project settings > Your apps > Web).
# Must be the same project as the app's google-services.json and the
# service-account private key stored in Settings.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# Docker network of the host's shared reverse proxy (edge mode).
EDGE_NETWORK=inviteos_default

# Admin sign-in normally verifies an Envato purchase code online. Keep 'off' for
# self-hosted deployments of this fork.
ENVATO_PURCHASE_CHECK=off
