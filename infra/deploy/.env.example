# ---------------------------------------------------------------------------
# bebu VPS deployment — copy to infra/deploy/.env and fill in every value.
# This file is read by docker compose AND injected into the API container.
# Never commit the filled-in copy.
# ---------------------------------------------------------------------------

# Public hostname (DNS A/AAAA records must already point at this server).
DOMAIN=ayushaura.in
ACME_EMAIL=you@example.com

# development | staging | production
#  - staging:    production builds, dev sign-in allowed (HMAC-signed tokens),
#                /admin wrapped in basic auth. Use this to test on the VPS
#                before Firebase is configured.
#  - production: fail-closed; requires Firebase + Agora credentials below.
APP_ENV=staging
CADDYFILE=Caddyfile.staging

# --- Datastores (passwords are generated for you by deploy.sh if empty) -----
POSTGRES_DB=bebu
POSTGRES_USER=bebu
POSTGRES_PASSWORD=
REDIS_PASSWORD=
DATABASE_POOL_MAX=20
REDIS_KEY_PREFIX=bebu

# --- Authentication ---------------------------------------------------------
# staging: AUTH_MODE=dev + DEV_AUTH_SECRET (>= 32 random chars, shared with the console)
# production: AUTH_MODE=firebase + Firebase service-account credentials
AUTH_MODE=dev
ADMIN_AUTH_MODE=dev
DEV_AUTH_SECRET=

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Escape newlines as \n when putting the key on one line.
FIREBASE_PRIVATE_KEY=

# --- Edge basic auth for /admin (staging only) ------------------------------
# Hash: docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-password'
# Write every `$` in the hash as `$$` (compose .env escaping). deploy.sh does this for you.
ADMIN_BASIC_AUTH_USER=ops
ADMIN_BASIC_AUTH_HASH=

# --- Real-time media (required in production) --------------------------------
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_TOKEN_TTL_SECONDS=3600

# --- Misc -------------------------------------------------------------------
ADMIN_BASE_PATH=/admin
LOG_LEVEL=info
CORS_ORIGINS=
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=120
QUEUE_WORKERS_ENABLED=true
METRICS_ENABLED=true
METRICS_TOKEN=

# Seed identity for the first super admin (used by `deploy.sh seed`)
SEED_SUPER_ADMIN_FIREBASE_UID=dev-super-admin
SEED_SUPER_ADMIN_EMAIL=admin@bebuapp.in
