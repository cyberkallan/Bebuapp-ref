# bebu public edge: this Caddy owns ports 80/443 and obtains Let's Encrypt
# certificates for DOMAIN. Use Caddyfile.edge instead when another reverse
# proxy on the host already terminates TLS.
{
	email {$ACME_EMAIL}
	servers {
		trusted_proxies static private_ranges
	}
}

import /etc/caddy/routes.caddy

{$DOMAIN} {
	import bebu_routes
}

# Redirect the bare www host to the apex.
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
