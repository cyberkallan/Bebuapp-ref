# bebu edge (behind a shared reverse proxy): plain HTTP on :80, reachable only
# from the host's public proxy, which terminates TLS for DOMAIN.
{
	auto_https off
	servers {
		trusted_proxies static private_ranges
	}
}

:80 {
	encode zstd gzip

	# Some admin code joins URLs with a double slash; collapse before routing.
	uri path_regexp /{2,} /

	# /gifts/* and /avatar-studio/* are bundled renders served by the backend;
	# the bare /gifts path (no trailing slash) is the admin's Gifts page.
	@backend path /api/* /storage/* /socket.io/* /avatar-studio/* /gifts/*
	handle @backend {
		reverse_proxy {$STACK_NAME:bebu}-backend:5000
	}

	handle {
		reverse_proxy {$STACK_NAME:bebu}-admin:5001
	}

	log {
		output stdout
		format json
	}
}
