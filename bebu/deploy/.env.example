# bebu server configuration. `./install.sh` writes this file for you; edit by
# hand only if you know what you are doing. Never commit the real .env.

# ── Where the server lives ───────────────────────────────────────────────────
# Host name the phone app and the admin panel will use.
#   api.example.com        → Caddy gets a Let's Encrypt certificate automatically
#   http://203.0.113.10    → plain HTTP on an IP, fine for a first trial
DOMAIN=api.example.com
# Same thing as a full URL, no trailing slash. Baked into the admin build.
PUBLIC_URL=https://api.example.com

# ── Secrets (install.sh generates these) ─────────────────────────────────────
# Shared secret between the app/admin and the backend (`key` header;
# Api.secretKey in the Flutter app).
SECRET_KEY=
# Admin panel session signing.
NEXTAUTH_SECRET=
# Encrypts admin-panel passwords in the database. Generated once; never change.
ADMIN_PASSWORD_KEY=

# ── Firebase web app config ──────────────────────────────────────────────────
# Firebase console → Project settings → Your apps → Web app. Must be the same
# project as the app's google-services.json and the service-account file
# deploy/firebase-service-account.json.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# ── Optional first-boot values (all editable later in Admin → Settings) ──────
ZEGO_APP_ID=
ZEGO_APP_SIGN=

# ── Branding ─────────────────────────────────────────────────────────────────
PROJECT_NAME=bebu
# Prefix for container names (bebu-mongo, bebu-backend, …). Change only when
# several stacks share one Docker host.
STACK_NAME=bebu
# MongoDB database name.
MONGO_DB=bebu

# ── Admin sign-up: Envato purchase-code check ───────────────────────────────
# Leave the token empty to accept any purchase code (self-hosted / your own
# installation). Sellers: put your Envato personal token + item id here.
ENVATO_PERSONAL_TOKEN=
ENVATO_ITEM_ID=

# ── Ports (standalone mode) ──────────────────────────────────────────────────
# Where Caddy listens on the host. Use 127.0.0.1:8080 style values to keep it
# local. Ignored in edge mode.
HTTP_BIND=80
HTTPS_BIND=443

# ── Edge mode: an existing reverse proxy on this host terminates TLS ────────
# Uncomment both lines; the proxy must forward DOMAIN to `${STACK_NAME}-edge:80`.
#COMPOSE_FILE=docker-compose.yml:docker-compose.edge.yml
#EDGE_NETWORK=proxy_default
