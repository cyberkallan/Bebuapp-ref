{
  "name": "bebu-platform",
  "version": "0.1.0",
  "private": true,
  "description": "bebu - multi-tenant real-time voice/video calling platform with coin-based billing",
  "homepage": "https://bebuapp.in/",
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24.11.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/**' build && pnpm -r --filter './apps/**' build",
    "build:packages": "pnpm -r --filter './packages/**' build",
    "dev": "pnpm -r --parallel --filter './apps/api' --filter './apps/admin' dev",
    "dev:api": "pnpm --filter @bebu/api dev",
    "dev:admin": "pnpm --filter @bebu/admin dev",
    "lint": "pnpm build:packages && pnpm -r lint",
    "typecheck": "pnpm build:packages && pnpm -r typecheck",
    "test": "pnpm build:packages && pnpm -r test",
    "test:e2e": "pnpm --filter @bebu/api test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @bebu/api db:generate",
    "db:migrate": "pnpm --filter @bebu/api db:migrate",
    "db:migrate:deploy": "pnpm --filter @bebu/api db:migrate:deploy",
    "db:seed": "pnpm --filter @bebu/api db:seed",
    "infra:up": "docker compose -f infra/docker/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker/docker-compose.yml down",
    "infra:logs": "docker compose -f infra/docker/docker-compose.yml logs -f",
    "clean": "pnpm -r clean && rm -rf node_modules"
  },
  "devDependencies": {
    "prettier": "^3.9.8"
  }
}
