# ------------------------------------------------------------------------------
# bebu platform - local development environment
#
# Copy to `.env` at the repository root:   cp .env.example .env
# Never commit `.env`. Values below are LOCAL DEFAULTS ONLY and must be replaced
# with secrets from your secret manager in staging/production.
# ------------------------------------------------------------------------------

# --- Runtime -------------------------------------------------------------------
NODE_ENV=development
# HTTP port for the NestJS API (uncommon port to avoid collisions)
API_PORT=4180
API_HOST=0.0.0.0
# Public base URL of the API (used in docs/links, not for binding)
API_PUBLIC_URL=http://127.0.0.1:4180

# --- Logging -------------------------------------------------------------------
# trace | debug | info | warn | error | fatal
LOG_LEVEL=debug
# Pretty-print logs locally. Must be false in production (JSON logs).
LOG_PRETTY=true

# --- HTTP security -------------------------------------------------------------
# Comma-separated list of allowed browser origins (admin panel, web app).
CORS_ORIGINS=http://127.0.0.1:4181,http://localhost:4181
# Global rate limit: max requests per window per client.
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=120
# Trust X-Forwarded-* headers from this many proxy hops (0 disables). Set to 1
# behind a single load balancer so client IPs and request IDs are correct.
TRUST_PROXY_HOPS=0

# --- PostgreSQL (source of truth) ---------------------------------------------
DATABASE_URL=postgresql://bebu:bebu@127.0.0.1:5432/bebu?schema=public
# Separate database used by API e2e/integration tests
DATABASE_URL_TEST=postgresql://bebu:bebu@127.0.0.1:5432/bebu_test?schema=public
DATABASE_POOL_MAX=20

# --- Redis (ephemeral state, locks, queues, rate limits) -----------------------
REDIS_URL=redis://127.0.0.1:6379/0
# Key prefix so several environments can share one Redis in non-prod
REDIS_KEY_PREFIX=bebu:dev

# --- Authentication (Firebase) -------------------------------------------------
# firebase : verify Firebase ID tokens with the Admin SDK (required in production)
# dev      : accept unsigned local dev tokens - REFUSED when NODE_ENV=production
AUTH_MODE=dev
FIREBASE_PROJECT_ID=
# Service-account credentials for the Admin SDK. Provide EITHER a path to the
# JSON file (recommended in containers via a mounted secret) OR the three fields.
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_CLIENT_EMAIL=
# Keep literal "\n" sequences; the config loader converts them to newlines.
FIREBASE_PRIVATE_KEY=

# --- Agora RTC -----------------------------------------------------------------
# The App Certificate is a server-side secret. It must never reach a client.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
# Lifetime of RTC tokens issued to call participants
AGORA_TOKEN_TTL_SECONDS=3600

# --- Background jobs -----------------------------------------------------------
# Set to false on API replicas that should only enqueue jobs, not process them.
QUEUE_WORKERS_ENABLED=true

# --- Observability -------------------------------------------------------------
METRICS_ENABLED=true
# Optional shared secret required to read /metrics. Empty = unauthenticated
# (only acceptable when the endpoint is not exposed publicly).
METRICS_TOKEN=

# --- Admin panel (Next.js) -----------------------------------------------------
# The panel calls the API from the server only (Server Components/Actions), so
# the admin session token never reaches the browser.
BEBU_API_URL=http://127.0.0.1:4180
# dev      : sign in with a seeded admin uid/email (refused when NODE_ENV=production)
# firebase : Firebase sign-in (wired in the authentication stage)
ADMIN_AUTH_MODE=dev
ADMIN_PORT=4181

# --- Seed data (development only) ---------------------------------------------
SEED_SUPER_ADMIN_FIREBASE_UID=dev-super-admin
SEED_SUPER_ADMIN_EMAIL=admin@bebuapp.in
